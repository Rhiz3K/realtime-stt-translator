# ============================================================================
# SR Live Translator - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ============================================================================

# --- Authentication ---

# Password for accessing the app. Required when AUTH_ENABLED=true.
APP_PASSWORD=change-me

# Enable/disable password login (default: true).
# Set to false to allow anonymous access (useful behind VPN/reverse proxy auth).
AUTH_ENABLED=true

# Separate signing secret for auth cookies (defaults to APP_PASSWORD if empty).
AUTH_SECRET=change-me-too

# Auth cookie name.
AUTH_COOKIE_NAME=srlt_auth

# Auth token TTL in seconds (default: 43200 = 12 hours).
AUTH_TOKEN_TTL_SECONDS=43200

# Cookie Secure flag: true = always (needs HTTPS; browsers also accept it on
# http://localhost), false = never (plain-http LAN testing only), empty = derive
# from the request scheme — which is "http" behind a TLS-terminating proxy unless
# uvicorn trusts its X-Forwarded-Proto (see FORWARDED_ALLOW_IPS below).
AUTH_COOKIE_SECURE=true

# --- Origins ---

# Restrict allowed WebSocket origins (comma-separated).
# If empty, origin host must match the request Host header.
# ALLOWED_ORIGINS=https://translator.example.com,https://www.translator.example.com
ALLOWED_ORIGINS=

# --- STT Engines ---

# Which engines are available to users. Comma-separated.
# Valid: webspeech, whisper, nemotron, parakeet, deepgram, elevenlabs, azure
# whisper  = browser-local ONNX (no API key; first run downloads model from Hugging Face)
# nemotron = browser-local NVIDIA Nemotron-3.5-ASR streaming ONNX (no API key; WebGPU
#            recommended). Build the model first — see app/static/nemotron/README.md.
# parakeet = browser-local NVIDIA Parakeet-tdt-0.6b-v3 ONNX (no API key; multilingual
#            incl. Czech; WebGPU recommended). Build assets first:
#            python scripts/prepare_parakeet_onnx.py
# azure    = Azure AI Speech, browser-direct (needs AZURE_SPEECH_KEY + AZURE_SPEECH_REGION).
# deepgram / elevenlabs need their API keys below; an enabled engine without its
# key shows up in the UI but fails on Start. Disabled engines appear grayed out.
ENABLED_ENGINES=webspeech,whisper

# When "nemotron" is enabled, create app/static/nemotron/models and build missing
# model assets on container start. First run downloads ~2.6 GB and writes ~1.3 GB.
NEMOTRON_AUTO_PREPARE=true

# Max seconds for the Nemotron model preparation step (0 disables the timeout).
NEMOTRON_PREPARE_TIMEOUT_SECONDS=1800

# --- Deepgram ---

# API key from https://console.deepgram.com/
# Required when "deepgram" is in ENABLED_ENGINES.
DEEPGRAM_API_KEY=

# Maximum queued Deepgram final transcripts. Pending interim hypotheses are
# coalesced; if this limit is reached, the session stops instead of losing a final.
DEEPGRAM_RESULT_QUEUE_SIZE=100

# --- ElevenLabs ---

# API key from https://elevenlabs.io/app/settings/api-keys
# Required when "elevenlabs" is in ENABLED_ENGINES (server mode).
# In browser mode users can also provide their own key in the UI.
ELEVENLABS_API_KEY=

# --- Azure AI Speech ---

# Browser-direct mode: the server only mints a short-lived token; the browser
# SpeechSDK streams audio. Required when "azure" is in ENABLED_ENGINES (users
# can also provide their own key/region in the UI). Free F0 tier ~5 hrs/month.
# Key + region from the Azure Portal Speech resource (region e.g. westeurope).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Translation ---

# Max accepted input text length per message (default: 5000).
MAX_TEXT_LENGTH=5000

# Timeout for a single translation call in seconds (default: 10).
TRANSLATE_TIMEOUT_SECONDS=10

# Translation providers. googletrans (free, no key, unofficial — Google throttles it
# per IP with HTTP 429) is always available. DeepL is added when DEEPL_API_KEY is set
# (https://www.deepl.com/pro-api; free keys end with ":fx" and give 500k chars/month —
# translated interims count towards that too).
DEEPL_API_KEY=
# Override the DeepL endpoint (default: api-free.deepl.com for ":fx" keys, else api.deepl.com).
# DEEPL_API_URL=

# Which provider to use: "auto" (default) tries google first and switches to deepl
# while google is rate limited; "google" or "deepl" pins one (never switches);
# "deepl,google" is an explicit preference order. Users can override this per
# session in Settings -> Translation provider.
TRANSLATE_PROVIDER=auto

# How long "auto" skips a provider after it answered 429/456 (seconds, default: 600).
TRANSLATE_FALLBACK_COOLDOWN_SECONDS=600

# --- Deployment: Docker + reverse proxy ---

# Port the container's uvicorn listens on (Dockerfile CMD; Coolify usually sets it).
# PORT=8000

# Read by uvicorn, not the app: X-Forwarded-For / X-Forwarded-Proto are honoured
# only from these addresses (default: 127.0.0.1). Behind Coolify/Traefik, nginx or
# Caddy set it to the proxy's IP or docker network (CIDR, comma-separated), e.g.
# FORWARDED_ALLOW_IPS=172.16.0.0/12 — otherwise every visitor shares the proxy's IP
# for login rate limiting and the auto-detected scheme is "http". Use "*" only if
# uvicorn's port is not reachable directly (anyone could spoof the headers then).
# FORWARDED_ALLOW_IPS=

# --- On-device model asset locations (prep scripts only) ---

# Where scripts/prepare_nemotron_onnx.py and scripts/prepare_parakeet_onnx.py
# write the generated model files. Defaults to app/static/<engine>/models/, which
# is what the browser engines fetch — only set these to build the assets
# elsewhere (e.g. a mounted volume) and symlink/copy them into place.
# NEMOTRON_MODEL_DIR=
# PARAKEET_MODEL_DIR=
