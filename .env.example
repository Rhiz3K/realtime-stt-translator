# Required Google Gemini API key. It stays on the server and is never exposed to
# the browser. Create one at https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=your-api-key

# Password login is enabled by default. Replace the example password before
# startup, or disable it only when a trusted reverse proxy provides authentication.
APP_PASSWORD=change-me
AUTH_ENABLED=true

# A separate long random signing secret is recommended in production. When left
# empty, APP_PASSWORD is used. Example: openssl rand -hex 32
AUTH_SECRET=
AUTH_COOKIE_NAME=translator_auth
AUTH_TOKEN_TTL_SECONDS=43200

# true = always mark the cookie Secure, false = allow plain HTTP, empty = derive
# from the request/proxy scheme. Production deployments should use true + HTTPS.
AUTH_COOKIE_SECURE=

# Optional exact WebSocket Origin allowlist. With no value, Origin must match Host.
# Example: https://translator.example.com,https://www.translator.example.com
ALLOWED_ORIGINS=

# Docker/Uvicorn deployment settings (not read by application code directly).
# PORT=8000
# FORWARDED_ALLOW_IPS=172.16.0.0/12
